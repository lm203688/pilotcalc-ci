{
  "name": "PilotCalc",
  "slug": "pilotcalc",
  "version": "1.0.1",
  "orientation": "portrait",
  "scheme": "pilotcalc",
  "userInterfaceStyle": "dark",
  "newArchEnabled": true,
  "icon": "./assets/icon.png",
  "assetBundlePatterns": [
    "**/*"
  ],
  "ios": {
    "supportsTablet": false,
    "bundleIdentifier": "com.example.pilotcalc",
    "buildNumber": "2",
    "infoPlist": {
      "ITSAppUsesNonExemptEncryption": false,
      "UISupportedInterfaceOrientations": [
        "UIInterfaceOrientationPortrait"
      ],
      "UIApplicationShortcutItems": [
        {
          "UIApplicationShortcutItemType": "pilotcalc.wind",
          "UIApplicationShortcutItemTitle": "Wind triangle",
          "UIApplicationShortcutItemSubtitle": "Heading & groundspeed",
          "UIApplicationShortcutItemIconType": "UIApplicationShortcutIconTypeCompose"
        },
        {
          "UIApplicationShortcutItemType": "pilotcalc.tod",
          "UIApplicationShortcutItemTitle": "Top of descent",
          "UIApplicationShortcutItemSubtitle": "Start down",
          "UIApplicationShortcutItemIconType": "UIApplicationShortcutIconTypeArrowDown"
        }
      ]
    }
  },
  "plugins": [
    "./plugins/withUIScene.cjs",
    [
      "expo-build-properties",
      {
        "ios": {
          "deploymentTarget": "16.0"
        }
      }
    ],
    "./plugins/withDeploymentTarget"
  ]
}
